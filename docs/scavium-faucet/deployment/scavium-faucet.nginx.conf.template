# This file is included from nginx's http{} context via sites-enabled.

upstream scavium_faucet_backend {
    server 127.0.0.1:18080;
    keepalive 32;
}

# Basic anti-abuse limits. Adjust to traffic profile.
limit_req_zone $binary_remote_addr zone=faucet_req:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=faucet_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name faucet.testnet.scavium.network;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name faucet.testnet.scavium.network;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    ssl_certificate /etc/letsencrypt/live/faucet.testnet.scavium.network/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/faucet.testnet.scavium.network/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src https://hcaptcha.com https://*.hcaptcha.com; script-src 'self' https://hcaptcha.com https://*.hcaptcha.com" always;
    # Enable only after HTTPS has been validated as stable.
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 65s;
    send_timeout 30s;

    location / {
        limit_req zone=faucet_req burst=20 nodelay;
        limit_conn faucet_conn 20;

        proxy_pass http://scavium_faucet_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
