[Unit]
Description=SCAVIUM Faucet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scavium-faucet
Group=scavium-faucet
WorkingDirectory=/opt/scavium-faucet
EnvironmentFile=/etc/scavium-faucet/scavium-faucet.env
ExecStart=/opt/scavium-faucet/bin/scavium-faucet
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Writable state for SQLite under ProtectSystem=strict.
StateDirectory=scavium-faucet
ReadWritePaths=/var/lib/scavium-faucet

UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
