# Example only. Replace placeholders outside the repository.
# Do not commit real secrets or funded private keys.

# Backend must stay loopback-only; nginx is the public entrypoint.
SCAVIUM_FAUCET_BIND_ADDR=127.0.0.1:18080
SCAVIUM_FAUCET_PUBLIC_BASE_URL=https://faucet.testnet.scavium.network

# Chain / RPC
SCAVIUM_FAUCET_RPC_URL=http://127.0.0.1:18545
SCAVIUM_FAUCET_CHAIN_ID=REPLACE_WITH_CHAIN_ID
SCAVIUM_FAUCET_NETWORK_NAME=REPLACE_WITH_NETWORK_NAME
SCAVIUM_FAUCET_SYMBOL=SCAV
SCAVIUM_FAUCET_EXPLORER_TX_URL=https://REPLACE_WITH_EXPLORER_DOMAIN/tx/{txHash}

# Core faucet behavior
SCAVIUM_FAUCET_AMOUNT_WEI=1000000000000000000
SCAVIUM_FAUCET_COOLDOWN_SECONDS=86400
SCAVIUM_FAUCET_RATE_LIMIT_IP_PER_HOUR=10
SCAVIUM_FAUCET_RATE_LIMIT_ADDR_PER_DAY=3
SCAVIUM_FAUCET_ABUSE_ENFORCEMENT_ENABLED=true
SCAVIUM_FAUCET_ABUSE_ENFORCEMENT_WINDOW_SECONDS=3600
SCAVIUM_FAUCET_ABUSE_ENFORCEMENT_IP_THRESHOLD=20
SCAVIUM_FAUCET_ABUSE_ENFORCEMENT_ADDRESS_THRESHOLD=12
SCAVIUM_FAUCET_ABUSE_ENFORCEMENT_FINGERPRINT_THRESHOLD=15
SCAVIUM_FAUCET_DRY_RUN=false
SCAVIUM_FAUCET_MODE=active

# Persistence
SCAVIUM_FAUCET_DATABASE_PATH=/var/lib/scavium-faucet/scavium-faucet.db

# Trusted proxy for real client IP extraction behind nginx.
SCAVIUM_FAUCET_TRUSTED_PROXY=127.0.0.1

# CORS exact-origin allow-list (optional).
# Leave empty to disable CORS headers. Wildcard '*' is rejected.
# SCAVIUM_FAUCET_CORS_ALLOWED_ORIGINS=https://faucet.testnet.scavium.network

# Optional daily distribution cap (wei per UTC day).
# Example: 100 ETH = 100000000000000000000
# SCAVIUM_FAUCET_DAILY_BUDGET_WEI=100000000000000000000

# Worker and watcher
SCAVIUM_FAUCET_WORKER_ENABLED=true
SCAVIUM_FAUCET_WORKER_POLL_SECONDS=5
SCAVIUM_FAUCET_WATCHER_ENABLED=true
SCAVIUM_FAUCET_WATCHER_POLL_SECONDS=15
SCAVIUM_FAUCET_MIN_CONFIRMATIONS=1

# Captcha
# Provider: disabled | dev | hcaptcha | recaptcha | turnstile
# Recommended public deployment baseline: turnstile or hcaptcha.
SCAVIUM_FAUCET_CAPTCHA_PROVIDER=turnstile
SCAVIUM_FAUCET_CAPTCHA_SITE_KEY=REPLACE_WITH_PUBLIC_CAPTCHA_SITE_KEY
SCAVIUM_FAUCET_CAPTCHA_SECRET=REPLACE_WITH_CAPTCHA_SECRET
# Optional override; empty uses the provider default verify endpoint.
# SCAVIUM_FAUCET_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Secrets (placeholders only)
SCAVIUM_FAUCET_PRIVATE_KEY=REPLACE_WITH_FAUCET_PRIVATE_KEY
SCAVIUM_FAUCET_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN
